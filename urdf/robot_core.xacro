<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ==================================================================== -->
  <!--  Robot dimensions (single source of truth)                           -->
  <!--  Small, symmetric, low centre of mass = stable + easy to learn.      -->
  <!-- ==================================================================== -->
  <xacro:property name="chassis_length" value="0.35"/>
  <xacro:property name="chassis_width"  value="0.22"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass"   value="4.0"/>

  <xacro:property name="wheel_radius"   value="0.06"/>
  <xacro:property name="wheel_width"    value="0.045"/>
  <xacro:property name="wheel_mass"     value="0.5"/>

  <!-- longitudinal distance of each wheel centre from robot centre -->
  <xacro:property name="wheel_xoff"     value="0.13"/>
  <!-- lateral distance of each wheel centre from robot centre -->
  <xacro:property name="wheel_yoff"     value="${chassis_width/2 + wheel_width/2}"/>

  <!-- height of base_link origin above the ground -->
  <xacro:property name="ground_clearance" value="0.02"/>

  <!-- ==================================================================== -->
  <!--  Frames                                                              -->
  <!-- ==================================================================== -->

  <!-- base_footprint: ground-projected origin, the frame Nav2/RL treat as
       "the robot". Sits on the floor directly under the chassis centre. -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + ground_clearance}" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================================== -->
  <!--  Chassis                                                             -->
  <!-- ==================================================================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ==================================================================== -->
  <!--  Wheel macro (4x, skid-steer)                                        -->
  <!--  x_reflect: +1 front, -1 back    y_reflect: +1 left, -1 right        -->
  <!-- ==================================================================== -->
  <xacro:macro name="wheel" params="prefix x_reflect y_reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wheel_mass}" length="${wheel_width}" radius="${wheel_radius}">
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="${x_reflect*wheel_xoff} ${y_reflect*wheel_yoff} ${-ground_clearance}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:wheel prefix="back_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:wheel prefix="back_right"  x_reflect="-1" y_reflect="-1"/>

  <!-- ==================================================================== -->
  <!--  Lidar mast + lidar link (on top, centred for a symmetric scan)      -->
  <!-- ==================================================================== -->
  <xacro:property name="mast_height" value="0.06"/>
  <xacro:property name="lidar_height" value="0.035"/>
  <xacro:property name="lidar_radius" value="0.038"/>

  <link name="lidar_mast">
    <visual>
      <origin xyz="0 0 ${mast_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 ${mast_height}"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${mast_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 ${mast_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.15" x="0.05" y="0.05" z="${mast_height}">
      <origin xyz="0 0 ${mast_height/2}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="lidar_mast_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_mast"/>
    <origin xyz="0 0 ${chassis_height}" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" length="${lidar_height}" radius="${lidar_radius}">
      <origin xyz="0 0 ${lidar_height/2}" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mast"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 ${mast_height}" rpy="0 0 0"/>
  </joint>

</robot>
