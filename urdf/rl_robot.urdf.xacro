<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rl_robot">

  <!-- 4-wheel skid-steer robot with a top-mounted 2D lidar.
       Built for reinforcement-learning (obstacle avoidance / goal reaching):
         action  -> /cmd_vel   observation -> /scan (+ /odom)  -->

  <xacro:include filename="materials.xacro"/>
  <xacro:include filename="robot_core.xacro"/>
  <xacro:include filename="gazebo_control.xacro"/>
  <xacro:include filename="lidar.xacro"/>

</robot>
