<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rl_robot</name>
  <version>0.1.0</version>
  <description>
    4-wheel skid-steer robot with a top-mounted 2D lidar, built as a
    reinforcement-learning platform (obstacle avoidance / goal reaching) for
    ROS 2 Humble + Gazebo Classic. Exposes /cmd_vel (action), /scan and /odom
    (observation).
  </description>
  <maintainer email="arham.15amir@gmail.com">arham</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
